{
    "name": "recall",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build:assets": "webpack --mode production",
        "build": "npm run build:assets",
        "dev": "npm run build:assets && php -S 127.0.0.1:8080 -t app docker-router.php",
        "test": "npm run test:client && npm run check:i18n && npm run test:api",
        "test:client": "node --test tests/*.test.mjs",
        "check:i18n": "node tools/check-i18n.mjs",
        "test:api": "php api/tests/run.php",
        "icons": "node tools/make-icons.mjs"
    },
    "devDependencies": {
        "copy-webpack-plugin": "^14.0.0",
        "css-loader": "^7.1.5",
        "css-minimizer-webpack-plugin": "^8.0.0",
        "html-webpack-plugin": "^5.6.8",
        "mini-css-extract-plugin": "^2.10.2",
        "sass": "^1.104.1",
        "sass-loader": "^17.0.1",
        "webpack": "^5.111.1",
        "webpack-cli": "^7.2.3"
    }
}
